# Backend Server Port
PORT=5000

# Sentinel-2 Online STAC Catalog Endpoint
# Default: Open AWS Element84 STAC (requires NO API key)
STAC_API_URL=https://earth-search.aws.element84.com/v1/search

# (Optional) Copernicus Data Space Ecosystem (CDSE) credentials
# Get free account at: https://dataspace.copernicus.eu/
# If left blank, the system automatically uses the open AWS Earth Search provider.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
